{
  "mainClass": "PersonalProjectPart2",
  "tests": [
    {
      "id": "compile",
      "title": "Java syntax and class structure are valid",
      "type": "compile"
    },
    {
      "id": "strings",
      "title": "Taught String processing is used meaningfully",
      "type": "source",
      "patterns": [
        "(\\.(trim|replace|substring|toUpperCase|toLowerCase|indexOf|contains|charAt|length|compareTo|compareToIgnoreCase|equalsIgnoreCase|startsWith|endsWith)\\s*\\(|new\\s+StringBuilder\\s*\\()"
      ]
    },
    {
      "id": "validation",
      "title": "A loop continues until important input is valid",
      "type": "source",
      "patterns": [
        "\\b(while|for)\\s*\\(",
        "\\.(trim|isBlank|isEmpty)\\s*\\(",
        "System\\.out\\.print"
      ]
    },
    {
      "id": "collection",
      "title": "An array or ArrayList stores project data",
      "type": "source",
      "mode": "any",
      "patterns": [
        "\\w+\\s*\\[\\s*\\]",
        "ArrayList\\s*<"
      ]
    }
  ]
}
