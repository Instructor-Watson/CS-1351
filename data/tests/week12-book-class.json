{
  "mainClass": "BookDemo",
  "tests": [
    {
      "id": "compile",
      "title": "Java syntax and class structure are valid",
      "type": "compile"
    },
    {
      "id": "fields-constructor",
      "title": "Book has private fields initialized by its constructor",
      "type": "source",
      "patterns": [
        "private\\s+String\\s+title",
        "private\\s+int\\s+pages",
        "this\\.title\\s*=\\s*title",
        "this\\.pages\\s*=\\s*pages"
      ]
    },
    {
      "id": "object-methods",
      "title": "Book provides getters and a description method",
      "type": "source",
      "patterns": [
        "String\\s+getTitle\\s*\\(",
        "int\\s+getPages\\s*\\(",
        "String\\s+describe\\s*\\("
      ]
    },
    {
      "id": "objects-comparison",
      "title": "Two books are created and compared by page count",
      "type": "source",
      "patterns": [
        "new\\s+Book\\s*\\(\\s*\\\"Charlotte's Web\\\"\\s*,\\s*192\\s*\\)",
        "new\\s+Book\\s*\\(\\s*\\\"The Hobbit\\\"\\s*,\\s*310\\s*\\)",
        "getPages\\s*\\(\\s*\\)\\s*>"
      ]
    },
    {
      "id": "example-1",
      "title": "Required example 1 produces the expected result",
      "type": "run",
      "input": "",
      "outputContains": [
        "Charlotte's Web - 192 pages",
        "The Hobbit - 310 pages",
        "Longer book: The Hobbit"
      ]
    }
  ]
}
