{
  "mainClass": "PlaylistDemo",
  "tests": [
    {
      "id": "compile",
      "title": "Java syntax and class structure are valid",
      "type": "compile"
    },
    {
      "id": "collection",
      "title": "Playlist owns and initializes an ArrayList of Strings",
      "type": "source",
      "patterns": [
        "private\\s+ArrayList\\s*<\\s*String\\s*>\\s+songs",
        "this\\.songs\\s*=\\s*new\\s+ArrayList"
      ]
    },
    {
      "id": "wrappers",
      "title": "Wrapper methods add, remove, inspect, and display songs",
      "type": "source",
      "patterns": [
        "void\\s+addSong\\s*\\(",
        "\\.add\\s*\\(\\s*title\\s*\\)",
        "String\\s+playNext\\s*\\(",
        "\\.remove\\s*\\(\\s*0\\s*\\)",
        "boolean\\s+isEmpty\\s*\\(",
        "\\.isEmpty\\s*\\(",
        "for\\s*\\(\\s*String\\s+\\w+\\s*:\\s*(this\\.)?songs\\s*\\)"
      ]
    },
    {
      "id": "helpers",
      "title": "Private helper methods locate and swap songs",
      "type": "source",
      "patterns": [
        "private\\s+void\\s+swapSongs\\s*\\(",
        "\\.set\\s*\\(",
        "private\\s+int\\s+indexLowest\\s*\\(",
        "\\.compareTo\\s*\\(",
        "return\\s+lowest\\s*;"
      ]
    },
    {
      "id": "selection-sort",
      "title": "selectionSort repeatedly finds and swaps the lowest remaining song",
      "type": "source",
      "patterns": [
        "void\\s+selectionSort\\s*\\(",
        "for\\s*\\(",
        "indexLowest\\s*\\(\\s*i\\s*\\)",
        "swapSongs\\s*\\(\\s*i\\s*,\\s*lowest\\s*\\)"
      ]
    },
    {
      "id": "example-1",
      "title": "Required example 1 produces the expected result",
      "type": "run",
      "input": "",
      "outputContains": [
        "Original playlist:",
        "Imagine",
        "Happy",
        "Here Comes the Sun",
        "Sorted playlist:",
        "Playing next: Happy",
        "Playlist empty: false"
      ]
    }
  ]
}
