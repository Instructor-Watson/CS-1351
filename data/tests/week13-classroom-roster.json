{
  "mainClass": "ClassroomRoster",
  "tests": [
    {
      "id": "compile",
      "title": "Java syntax and class structure are valid",
      "type": "compile"
    },
    {
      "id": "immutable-student",
      "title": "Student stores immutable ID and name data",
      "type": "source",
      "patterns": [
        "private\\s+final\\s+int\\s+id",
        "private\\s+final\\s+String\\s+name",
        "this\\.id\\s*=\\s*id",
        "this\\.name\\s*=\\s*name"
      ]
    },
    {
      "id": "object-methods",
      "title": "Student provides getters, toString, and value equality",
      "type": "source",
      "patterns": [
        "int\\s+getId\\s*\\(",
        "String\\s+getName\\s*\\(",
        "String\\s+toString\\s*\\(",
        "boolean\\s+equals\\s*\\(\\s*Student",
        "this\\.name\\.equals\\s*\\("
      ]
    },
    {
      "id": "object-array",
      "title": "Ada, Grace, and James are stored in a Student array",
      "type": "source",
      "patterns": [
        "Student\\s*\\[\\s*\\]\\s*students",
        "new\\s+Student\\s*\\(\\s*101\\s*,\\s*\\\"Ada\\\"",
        "new\\s+Student\\s*\\(\\s*102\\s*,\\s*\\\"Grace\\\"",
        "new\\s+Student\\s*\\(\\s*103\\s*,\\s*\\\"James\\\""
      ]
    },
    {
      "id": "traversal-search",
      "title": "The roster is traversed and searched sequentially",
      "type": "source",
      "patterns": [
        "void\\s+printRoster\\s*\\(",
        "for\\s*\\(\\s*Student\\s+\\w+\\s*:\\s*students\\s*\\)",
        "int\\s+findStudent\\s*\\(",
        "\\.equals\\s*\\(\\s*target\\s*\\)",
        "return\\s+-1\\s*;"
      ]
    },
    {
      "id": "example-1",
      "title": "Required example 1 produces the expected result",
      "type": "run",
      "input": "",
      "outputContains": [
        "101 - Ada",
        "102 - Grace",
        "103 - James",
        "Grace index: 1",
        "Linus index: -1"
      ]
    }
  ]
}
